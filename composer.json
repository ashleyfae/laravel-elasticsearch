{
    "name": "ashleyfae/laravel-elasticsearch",
    "description": "Elasticsearch query builder for Laravel.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ashleyfae\\LaravelElasticsearch\\": "src/",
            "Ashleyfae\\LaravelElasticsearch\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ashleyfae\\LaravelElasticsearch\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "elasticsearch/elasticsearch": "^9.4"
    },
    "require-dev": {
        "orchestra/testbench": "^7.1.0",
        "mockery/mockery": "^1.5",
        "dg/bypass-finals": "dev-master",
        "guzzlehttp/psr7": "3.0.x-dev"
    },
    "extra": {
        "laravel": {
            "providers": [
                "\\Ashleyfae\\LaravelElasticsearch\\ElasticServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
